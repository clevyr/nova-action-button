{
    "name": "clevyr/nova-action-button",
    "description": "A Laravel Nova field to run actions.",
    "keywords": [
        "laravel",
        "nova"
    ],
    "license": "MIT",
    "homepage": "https://github.com/pdmfc/nova-action-button",
    "authors": [
        {
            "name": "João Santos",
            "email": "joao.santos@pdmfc.com",
            "role": "Developer"
        },
      {
          "name": "Anthony Protano",
          "email": "anthony@clevyr.com",
          "role": "Developer"
      }
    ],
    "repositories": [
        {
            "type": "composer",
            "url": "https://nova.laravel.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "laravel/nova": "^5.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "laravel/pint": "^1.21"
    },
    "autoload": {
        "psr-4": {
            "Clevyr\\NovaFields\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Clevyr\\NovaFields\\ActionButtonFieldServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit --colors=always tests",
        "fix-style": "./vendor/bin/pint"
    },
    "prefer-stable": true
}
